{
  "name": "sqlparity",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only SQL tools for data-migration verification: bulk query generation, schema diffing, escaping, formatting, query review and dialect conversion. Nothing leaves your machine.",
  "scripts": {
    "predev": "node scripts/copy-duckdb.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-duckdb.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "dt-sql-parser": "^4.5.1",
    "fflate": "^0.8.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql-formatter": "^15.8.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
